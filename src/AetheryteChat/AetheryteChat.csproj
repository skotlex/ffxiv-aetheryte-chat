<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <!-- 매니페스트 필드. Dalamud 공식 목록 대신 이 저장소의 repo.json(사용자 정의 플러그인 저장소)으로 배포한다. 버전은 릴리스 태그에서 정한다 (.github/workflows/release.yml) -->
    <Author>skotlex</Author>
    <Name>Aetheryte Chat</Name>
    <Punchline>일본 DC 채팅을 한국어로 읽고, 한국어로 써서 일본어로 보냅니다.</Punchline>
    <Description>받은 채팅을 일→한으로 번역하고, 한국어로 입력한 글을 한→일로 번역해 게임 채팅으로 보냅니다.
Square Enix와 관련 없는 비공식 도구입니다.</Description>
    <RepoUrl>https://github.com/skotlex/ffxiv-aetheryte-chat</RepoUrl>
    <Tags>chat;translation;korean;japanese</Tags>
    <!-- 플러그인 목록의 아이콘. 저장소로 설치하면 이 주소에서, Dev Plugin 은 DLL 옆의 images/icon.png 에서 읽는다 -->
    <IconUrl>https://raw.githubusercontent.com/skotlex/ffxiv-aetheryte-chat/main/src/AetheryteChat/images/icon.png</IconUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AetheryteChat</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- icon.svg 가 원본 (게임 리소스를 쓰지 않고 직접 그림). 고치면 512x512 PNG 로 다시 뽑는다 -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetheryteChat.Translation\AetheryteChat.Translation.csproj" />
  </ItemGroup>
</Project>
