<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <!-- 매니페스트 필드. Dalamud 공식 목록에는 올리지 않고 Dev Plugin 으로만 쓴다 (DESIGN 2절) -->
    <Author>skotlex</Author>
    <Name>Aetheryte Chat</Name>
    <Punchline>일본 DC 채팅을 한국어로 읽고, 한국어로 써서 일본어로 보낸다.</Punchline>
    <Description>Claude CLI 로 받은 채팅을 일→한 번역하고, 한국어 입력을 한→일 번역해 게임 채팅으로 보낸다.
Square Enix 와 관련 없는 비공식 도구.</Description>
    <RepoUrl>https://github.com/skotlex/ffxiv-aetheryte-chat</RepoUrl>
    <Tags>chat;translation;korean;japanese</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AetheryteChat</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetheryteChat.Translation\AetheryteChat.Translation.csproj" />
  </ItemGroup>
</Project>
